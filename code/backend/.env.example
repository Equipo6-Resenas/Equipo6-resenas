# Configuracion de PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resenas

# Variables usadas por docker-compose.yml de Reseñas
DB_PASSWORD=postgres
DB_PORT_PUBLISHED=5433

# Puerto de la API
PORT=3000

# Origen del frontend autorizado para llamadas desde el navegador
FRONTEND_ORIGIN=http://localhost:3000

# API Gateway e integracion con Catalogo
API_GATEWAY_URL=http://localhost:8080
CATALOGO_TIMEOUT_MS=2000

# Auth: introspección de sesión entre backends; nunca exponer la clave al frontend.
AUTH_SERVICE_URL=http://localhost:10000
AUTH_SERVICE_DOCKER_URL=http://auth-service:10000
AUTH_INTERNAL_API_KEY="<CONFIGURAR_EN_ENTORNO>"
AUTH_TIMEOUT_MS=1000

# Check-in: endpoint GET del servicio oficial en integracion
CHECKIN_SERVICE_URL=http://localhost:3005/api/checkin
CHECKIN_TIMEOUT_MS=2000

# URL de Catálogo desde Docker mediante el Gateway
API_GATEWAY_DOCKER_URL=http://ticketu-api-gateway:8080
CATALOGO_SERVICE_DOCKER_URL=http://ticketu-api-gateway:8080/api/catalogo
# Check-in desde Docker por la red compartida plataforma-eventos-net
CHECKIN_SERVICE_DOCKER_URL=http://checkin-service:3005/api/checkin

# Token servicio-a-servicio, cuando los equipos acuerden y habiliten autenticación
SERVICE_TO_SERVICE_TOKEN=

# ============================================================
# RabbitMQ - WORKSTATION OFICIAL (Entrega 4)
# ============================================================
# Usar EXCLUSIVAMENTE el broker compartido del Platform Team:
#   - Servicio: ticketu-rabbitmq (en red plataforma-eventos-net)
#   - Puerto: 5672 (AMQP), 15672 (Management UI)
#   - Credenciales: user=ticketu, pass=ticketu_dev, vhost=ticketu
#   - Exchange: ticketu.events (topic)
#
# NO levantar broker propio (requerimiento Platform Team).
# El docker-compose.yml NO incluye servicio rabbitmq.
# ============================================================

# Local (host) - para ejecución sin Docker apuntando a workstation
BROKER_URL=amqp://ticketu:ticketu_dev@localhost:5672/ticketu

# Docker - workstation oficial (broker compartido Platform Team)
BROKER_DOCKER_URL=amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu

EVENT_EXCHANGE=ticketu.events