# Configuracion de PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resenas

# Variables usadas por docker-compose.yml de Reseñas
DB_PASSWORD=postgres
DB_PORT_PUBLISHED=5433

# Puerto de la API
PORT=5000

# Origen del frontend autorizado para llamadas desde el navegador
FRONTEND_ORIGIN=http://localhost:3000

# API Gateway e integracion con Catalogo
API_GATEWAY_URL=http://localhost:8080
CATALOGO_TIMEOUT_MS=500
