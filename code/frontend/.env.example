# ============================================================================
# TicketU Front-end
# ============================================================================
#
# URL pública del API Gateway.
#
# Esta dirección es utilizada por el navegador, por lo que debe ser accesible
# desde fuera de los contenedores Docker.
#
# Desarrollo local:
#   http://localhost:8080
#
# Ejemplo en un servidor:
#   http://192.168.1.50:8080
#
# Ejemplo con dominio:
#   https://api.ticketu.cl
#
# No utilizar aquí nombres DNS internos de Docker como:
#   http://gateway:8080
# ============================================================================

NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
